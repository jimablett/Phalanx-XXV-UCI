### Phalanx Makefile
# editted by S.A to handle defaults passed by Scid Makefile

LINK ?= $(CC)

### DEFINES
### -DSHOW_FORCED_MOVES
### -DPBOOK_FILE=\"pbook.phalanx\"
### -DSBOOK_FILE=\"sbook.phalanx\"
### -DLEARN_FILE=\"learn.phalanx\"
### -DPBOOK_DIR=\"/usr/local/lib\"
### -DSBOOK_DIR=\"/usr/local/lib\"
### -DLEARN_DIR=\"/var/local/lib\"
### -DQCAPSONLY

CFLAGS = -march=k8 -mtune=core2 -O3 -flto=auto -funroll-loops -funsafe-math-optimizations -fsee
CFLAGS += -fomit-frame-pointer -fwhole-program -std=gnu23 

DEFINES = -DNDEBUG #-DGNUFUN

OBJ = .o/phalanx.o .o/bcreate.o .o/search.o .o/io.o .o/data.o .o/easy.o \
      .o/evaluate.o .o/genmoves.o .o/moving.o .o/hash.o .o/static.o \
      .o/levels.o .o/book.o .o/killers.o .o/endgame.o .o/learn.o .o/uci.o \
      .o/tbprobe.o .o/skill_level.o

phalanx: .o $(OBJ)
	$(LINK) $(CFLAGS) $(DEFINES) $(LDFLAGS) $(OBJ) -o phalanx

# New rule to compile the tbprobe source file from its subdirectory
.o/tbprobe.o: Makefile ./fathom/src/tbprobe.c
	$(CC) $(CFLAGS) $(DEFINES) -c ./fathom/src/tbprobe.c -o .o/tbprobe.o

.o/%.o: Makefile %.c
	$(CC) $(CFLAGS) $(DEFINES) -c $*.c -o .o/$*.o

.o:
	mkdir .o

clean:
	rm -rf .o phalanx *.lrn learn.phalanx

backup:
	tar -czvf Archive/phalanx.tgz \
	Makefile *.c *.h pbook.phalanx sbook.phalanx test.fin
